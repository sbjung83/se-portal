[Unit]
Description=SE Portal - Server Engineer Management App
After=network.target
RequiresMountsFor=/opt/se-portal

[Service]
Type=simple
User=appuser
WorkingDirectory=/opt/se-portal
ExecStart=/opt/se-portal/venv/bin/python -m uvicorn app:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
