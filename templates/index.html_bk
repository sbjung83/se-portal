<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0">
<title>SE Portal</title>
<style>
*{box-sizing:border-box;margin:0;padding:0}
body{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI','Noto Sans KR',sans-serif;font-size:14px;color:#1a1a1a;background:#f5f5f3}

/* ── AUTH ── */
.auth-wrap{display:flex;align-items:center;justify-content:center;height:100vh;background:#f5f5f3}
.auth-box{background:#fff;border:1px solid #e8e8e4;border-radius:12px;padding:32px 36px;width:380px;box-shadow:0 4px 20px rgba(0,0,0,.08)}
.auth-logo{text-align:center;font-size:18px;font-weight:700;margin-bottom:6px}
.auth-sub{text-align:center;font-size:12px;color:#aaa;margin-bottom:24px}
.auth-tabs{display:flex;margin-bottom:20px;border-bottom:1px solid #e8e8e4}
.auth-tab{flex:1;padding:8px;text-align:center;cursor:pointer;font-size:13px;color:#888;border-bottom:2px solid transparent;margin-bottom:-1px}
.auth-tab.active{color:#378ADD;border-bottom-color:#378ADD;font-weight:500}
.auth-pane{display:none}.auth-pane.active{display:block}
.auth-err{color:#991b1b;font-size:12px;margin-top:8px;min-height:18px}

/* ── APP ── */
.app{display:flex;height:100vh}
.sidebar{width:210px;flex-shrink:0;background:#fff;border-right:1px solid #e8e8e4;display:flex;flex-direction:column}
.sidebar-logo{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:6px;padding:16px 12px 14px;border-bottom:1px solid #2a2a2a;background:linear-gradient(135deg,#1a1a2e 0%,#16213e 100%)}
.sidebar-logo img{width:120px;height:auto;object-fit:contain}
.sidebar-logo-text{font-size:12px;font-weight:600;color:#7ec8e3;letter-spacing:2px;text-transform:uppercase}
.sidebar-eng{padding:10px 16px;font-size:12px;color:#888;border-bottom:1px solid #e8e8e4;display:flex;align-items:center;justify-content:space-between}
.nav-item{display:flex;align-items:center;gap:8px;padding:9px 16px;cursor:pointer;color:#666;font-size:13px;border-left:2px solid transparent;transition:all .12s;user-select:none}
.nav-item:hover{background:#f5f5f3;color:#1a1a1a}
.nav-item.active{background:#f0f7ff;color:#185FA5;border-left-color:#378ADD;font-weight:500}
.nav-item svg{width:15px;height:15px;flex-shrink:0}
.main{flex:1;overflow-y:auto;padding:24px 28px}
.page{display:none}.page.active{display:block}
.page-title{font-size:21px;font-weight:700;margin-bottom:18px;color:#111;letter-spacing:-.3px;border-left:4px solid #378ADD;padding-left:12px}

/* ── COMMON ── */
.card{background:#fff;border:1px solid #e8e8e4;border-radius:10px;padding:14px 18px;margin-bottom:12px}
.card-title{font-size:11px;font-weight:600;color:#888;text-transform:uppercase;letter-spacing:.5px;margin-bottom:10px;display:flex;justify-content:space-between;align-items:center}
.dash-card-title{font-size:13px;font-weight:700;color:#1a1a1a;text-transform:none;letter-spacing:0;margin-bottom:12px;display:flex;justify-content:space-between;align-items:center;padding-bottom:8px;border-bottom:2px solid #378ADD}
.grid2{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.grid3{display:grid;grid-template-columns:1fr 1fr 1fr;gap:12px}
.grid4{display:grid;grid-template-columns:repeat(4,1fr);gap:12px}
.metric{background:#f9f9f8;border-radius:8px;padding:12px 14px;border:1px solid #e8e8e4}
.metric-label{font-size:11px;color:#888;margin-bottom:4px;font-weight:500}
.metric-value{font-size:22px;font-weight:600}
.prog-wrap{background:#f0f0ee;border-radius:4px;height:5px;overflow:hidden;margin-top:5px}
.prog-bar{height:100%;border-radius:4px;background:#378ADD;transition:width .3s}
.badge{display:inline-flex;align-items:center;gap:3px;padding:2px 7px;border-radius:5px;font-size:11px;font-weight:500}
.b-blue{background:#dbeafe;color:#1d4ed8}.b-green{background:#dcfce7;color:#15803d}
.b-amber{background:#fef3c7;color:#92400e}.b-red{background:#fee2e2;color:#991b1b}
.b-purple{background:#ede9fe;color:#5b21b6}.b-gray{background:#f3f4f6;color:#374151}
/* 점검 유형 전용 배지 */
.b-monthly{background:#0ea5e9;color:#fff;font-weight:600}
.b-quarterly{background:#7c3aed;color:#fff;font-weight:600}
.b-special{background:#f59e0b;color:#fff;font-weight:600}
/* 점검 상태 전용 배지 */
.b-planned{background:#f1f5f9;color:#475569;border:1px solid #cbd5e1}
.b-done{background:#16a34a;color:#fff;font-weight:600}
.tbl{width:100%;border-collapse:collapse;font-size:13px}
.tbl th{text-align:left;font-weight:500;color:#888;padding:8px 12px;border-bottom:1px solid #e8e8e4;font-size:11px;text-transform:uppercase;letter-spacing:.4px;white-space:nowrap}
.tbl td{padding:8px 12px;border-bottom:1px solid #f0f0ee;vertical-align:middle;white-space:nowrap}
.tbl tr:last-child td{border-bottom:none}
.tbl tbody tr:hover td{background:#fafaf8}

/* ── 버튼 ── */
.btn{display:inline-flex;align-items:center;gap:4px;padding:6px 12px;border:1px solid #d4d4d0;border-radius:7px;background:#fff;color:#1a1a1a;font-size:12px;cursor:pointer;transition:all .12s;font-family:inherit;white-space:nowrap}
.btn:hover{background:#f5f5f3}.btn:active{transform:scale(.98)}
.btn-primary{background:#378ADD;color:#fff;border-color:#378ADD}.btn-primary:hover{background:#185FA5;border-color:#185FA5}
.btn-sm{padding:3px 8px;font-size:11px;border-radius:5px}
.btn-danger{color:#991b1b;border-color:#fca5a5}.btn-danger:hover{background:#fee2e2}
.btn-warn{color:#92400e;border-color:#fde68a}.btn-warn:hover{background:#fef3c7}

/* ── 아이콘 버튼 (수정/삭제 공용) ── */
.icon-btn{display:inline-flex;align-items:center;justify-content:center;width:26px;height:26px;border-radius:5px;border:1px solid transparent;background:transparent;cursor:pointer;transition:all .12s;flex-shrink:0}
.icon-btn:active{transform:scale(.93)}
.icon-btn.edit{color:#92400e;border-color:#fde68a}.icon-btn.edit:hover{background:#fef3c7}
.icon-btn.del{color:#991b1b;border-color:#fca5a5}.icon-btn.del:hover{background:#fee2e2}
.icon-btn svg{width:14px;height:14px;pointer-events:none}

/* ── 검색/폼 ── */
.search-bar{display:flex;gap:8px;margin-bottom:14px}
.search-bar input{flex:1;padding:7px 12px;border:1px solid #d4d4d0;border-radius:7px;background:#fff;font-size:13px;font-family:inherit}
.search-bar input:focus{outline:none;border-color:#378ADD}
.tabs{display:flex;border-bottom:1px solid #e8e8e4;margin-bottom:14px}
.tab{padding:7px 14px;font-size:13px;cursor:pointer;color:#888;border-bottom:2px solid transparent;margin-bottom:-1px}
.tab:hover{color:#1a1a1a}.tab.active{color:#378ADD;border-bottom-color:#378ADD;font-weight:500}
.tab-pane{display:none}.tab-pane.active{display:block}
.sec-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:10px}
.sec-label{font-size:11px;font-weight:600;color:#888;text-transform:uppercase;letter-spacing:.4px}
.empty{color:#bbb;font-size:13px;text-align:center;padding:20px 0}
.mono{font-family:'SF Mono','Fira Code',monospace;font-size:12px}
.pw-cell{cursor:pointer;font-family:monospace;color:#888;font-size:12px;user-select:none}
.pw-cell:hover{color:#1a1a1a}
.site-card{background:#fff;border:1px solid #e8e8e4;border-radius:10px;padding:12px 16px;margin-bottom:9px;cursor:pointer;transition:border-color .12s}
.site-card:hover{border-color:#378ADD}
.log-row{display:flex;gap:12px;padding:9px 2px;border-bottom:1px solid #f0f0ee;align-items:flex-start}
.log-row:last-child{border-bottom:none}
.log-date{font-size:11px;color:#aaa;min-width:78px;padding-top:2px}

/* ── 모달 ── */
.overlay{display:none;position:fixed;inset:0;background:rgba(0,0,0,.35);z-index:100;align-items:center;justify-content:center}
.overlay.open{display:flex}
.modal{background:#fff;border-radius:12px;border:1px solid #e8e8e4;padding:20px 24px;width:500px;max-height:90vh;overflow-y:auto;box-shadow:0 8px 32px rgba(0,0,0,.14)}
.modal-lg{width:min(960px,93vw)}
.modal-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:16px}
.modal-title{font-size:15px;font-weight:600}
.form-row{margin-bottom:11px}
.form-row label{display:block;font-size:11px;font-weight:600;color:#666;margin-bottom:3px;text-transform:uppercase;letter-spacing:.4px}
.form-row input,.form-row select,.form-row textarea{width:100%;padding:7px 10px;border:1px solid #d4d4d0;border-radius:7px;background:#fff;color:#1a1a1a;font-size:13px;font-family:inherit}
.form-row input:focus,.form-row select:focus,.form-row textarea:focus{outline:none;border-color:#378ADD}
.form-row textarea{resize:vertical;min-height:68px}
.form-actions{display:flex;justify-content:flex-end;gap:8px;margin-top:14px;padding-top:12px;border-top:1px solid #f0f0ee}
.toast{position:fixed;bottom:20px;right:20px;background:#1a1a1a;color:#fff;padding:10px 18px;border-radius:8px;font-size:13px;z-index:999;opacity:0;transition:opacity .2s;pointer-events:none}
.toast.show{opacity:1}
.w-alert{display:flex;align-items:center;gap:8px;padding:7px 11px;border-radius:7px;background:#fef3c7;color:#92400e;font-size:12px;margin-bottom:6px;border:1px solid #fde68a}
.w-alert.expired{background:#fee2e2;color:#991b1b;border-color:#fca5a5}

/* ── DASHBOARD 2단 레이아웃 ── */
.dash-body{display:grid;grid-template-columns:6fr 4fr;gap:14px;margin-top:14px}
.dash-left{display:flex;flex-direction:column;gap:12px}
.dash-right{display:flex;flex-direction:column;gap:12px}

/* ── 페이지네이션 ── */
.pagination{display:flex;align-items:center;justify-content:center;gap:4px;padding-top:10px;margin-top:8px;border-top:1px solid #f0f0ee}
.pg-btn{display:inline-flex;align-items:center;justify-content:center;width:26px;height:26px;border-radius:5px;border:1px solid #d4d4d0;background:#fff;color:#555;font-size:12px;cursor:pointer}
.pg-btn:hover{background:#f0f7ff;border-color:#378ADD;color:#378ADD}
.pg-btn.active{background:#378ADD;border-color:#378ADD;color:#fff;font-weight:600}
.pg-btn:disabled{opacity:.4;cursor:default}
.pg-info{font-size:11px;color:#aaa;margin:0 4px}

/* ── 이슈/체크 고정 높이 ── */
.fixed-list{min-height:220px}

/* ── 점검일정 ── */
.sched-item{display:flex;align-items:center;gap:6px;padding:9px 0;border-bottom:1px solid #f0f0ee;font-size:13px}
.sched-item:last-child{border-bottom:none}
.sched-date-label{font-size:11px;color:#aaa;min-width:50px;flex-shrink:0}

/* ── 이슈 상세 팝업 모달 ── */
.issue-popup{background:#fff;border-radius:12px;border:1px solid #e8e8e4;padding:22px 26px;width:540px;max-height:80vh;overflow-y:auto;box-shadow:0 8px 32px rgba(0,0,0,.14)}
.issue-popup-title{font-size:15px;font-weight:600;line-height:1.5;margin-bottom:10px;padding-right:8px}
.issue-popup-meta{display:flex;gap:6px;align-items:center;margin-bottom:14px;flex-wrap:wrap}
.issue-popup-body{font-size:13px;color:#444;line-height:1.8;white-space:pre-wrap;background:#f9f9f8;border-radius:8px;padding:14px 16px;border:1px solid #e8e8e4;min-height:60px}
</style>
</head>
<body>

<!-- ── 로그인 / 회원가입 ── -->
<div id="auth-wrap" class="auth-wrap">
  <div class="auth-box">
    <div class="auth-logo">🖥 SE Portal</div>
    <div class="auth-sub">Server Engineer 업무 관리 포털</div>
    <div class="auth-tabs">
      <div class="auth-tab active" onclick="switchAuth('login')">로그인</div>
      <div class="auth-tab" onclick="switchAuth('register')">회원가입</div>
    </div>
    <div class="auth-pane active" id="pane-login">
      <div class="form-row"><label>아이디</label><input type="text" id="login-user" placeholder="아이디 입력"></div>
      <div class="form-row"><label>비밀번호</label><input type="password" id="login-pw" placeholder="비밀번호 입력" onkeydown="if(event.key==='Enter')doLogin()"></div>
      <button class="btn btn-primary" style="width:100%;justify-content:center;margin-top:4px" onclick="doLogin()">로그인</button>
      <div class="auth-err" id="login-err"></div>
    </div>
    <div class="auth-pane" id="pane-register">
      <div class="form-row"><label>아이디</label><input type="text" id="reg-user" placeholder="영문/숫자 조합"></div>
      <div class="form-row"><label>비밀번호</label><input type="password" id="reg-pw" placeholder="비밀번호 입력"></div>
      <div class="form-row"><label>엔지니어 이름</label><input type="text" id="reg-eng" placeholder="본인 이름 (폴더명으로 사용)"></div>
      <button class="btn btn-primary" style="width:100%;justify-content:center;margin-top:4px" onclick="doRegister()">가입하기</button>
      <div class="auth-err" id="reg-err"></div>
    </div>
  </div>
</div>

<!-- ── 메인 앱 ── -->
<div id="main-app" class="app" style="display:none">
  <div class="sidebar">
    <div class="sidebar-logo">
      <img src="data:image/png;base64," alt="TodayGate Logo">
      <span class="sidebar-logo-text">SE Portal</span>
    </div>
    <div class="sidebar-eng">
      <span id="sidebar-eng-name" style="font-weight:500;color:#1a1a1a"></span>
      <button class="btn btn-sm" onclick="doLogout()">로그아웃</button>
    </div>
    <div style="height:6px"></div>
    <div class="nav-item active" data-page="dashboard">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>대시보드
    </div>
    <div class="nav-item" data-page="checklist">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 01-2 2H5a2 2 0 01-2-2V5a2 2 0 012-2h11"/></svg>사이트 체크리스트
    </div>
    <div class="nav-item" data-page="sites">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>사이트 관리
    </div>
    <div class="nav-item" data-page="logs">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>작업 이력
    </div>
  </div>

  <div class="main">
    <!-- DASHBOARD -->
    <div class="page active" id="page-dashboard">
      <div class="page-title" id="dash-title">대시보드</div>
      <div class="grid4" id="dash-metrics"></div>
      <div class="dash-body">
        <!-- 왼쪽 6 -->
        <div class="dash-left">
          <div class="card">
            <div class="dash-card-title">🔴 사이트 이슈 <button class="btn btn-sm" id="btn-add-issue">+ 추가</button></div>
            <div id="dash-issues" class="fixed-list"></div>
            <div id="dash-issues-page" class="pagination"></div>
          </div>
          <div class="card">
            <div class="dash-card-title">✅ 사이트 체크리스트</div>
            <div id="dash-cl" class="fixed-list"></div>
            <div id="dash-cl-page" class="pagination"></div>
          </div>
          <!-- 추후 콘텐츠 추가 예정 -->
        </div>
        <!-- 오른쪽 4 -->
        <div class="dash-right">
          <div class="card">
            <div class="dash-card-title"><span>📅 이번 달 점검 일정 <span style="color:#d4d4d0;margin:0 6px">|</span><span id="sched-summary" style="font-size:12px;font-weight:600;color:#378ADD">0/0 완료</span></span><button class="btn btn-sm" id="btn-add-sched">+ 등록</button></div>
            <div id="dash-schedules"></div>
          </div>

          <div class="card">
            <div class="dash-card-title">⚠️ 워런티 만료 임박</div>
            <div id="dash-warranty"></div>
          </div>
        </div>
      </div>
    </div>

    <!-- SITE CHECKLIST -->
    <div class="page" id="page-checklist">
      <div class="page-title">사이트 체크리스트</div>
      <div class="search-bar">
        <select id="cl-site-sel" style="flex:1;padding:7px 10px;border:1px solid #d4d4d0;border-radius:7px;font-size:13px;font-family:inherit" onchange="renderChecklist()">
          <option value="">— 사이트 선택 —</option>
        </select>
        <button class="btn btn-primary" onclick="openAddCLItem()">+ 항목 추가</button>
      </div>
      <div id="cl-content"></div>
    </div>

    <!-- SITES -->
    <div class="page" id="page-sites">
      <div class="page-title">사이트 관리</div>
      <div class="search-bar">
        <input type="text" id="site-search" placeholder="사이트명, 위치 검색...">
        <button class="btn btn-primary" onclick="openModal('modal-add-site')">+ 사이트 추가</button>
      </div>
      <div id="site-list"></div>
    </div>

    <!-- LOGS -->
    <div class="page" id="page-logs">
      <div class="page-title">작업 이력</div>
      <div class="search-bar">
        <input type="text" id="log-search" placeholder="사이트, 제목, 내용 검색...">
        <button class="btn btn-primary" id="btn-add-log">+ 이력 추가</button>
      </div>
      <div class="card"><div id="log-list"></div></div>
    </div>
  </div>
</div>

<!-- ── MODALS ── -->

<!-- 사이트 상세 -->
<div class="overlay" id="modal-site-detail">
  <div class="modal modal-lg">
    <div class="modal-head">
      <div class="modal-title" id="detail-site-name"></div>
      <button class="btn btn-sm" onclick="closeModal('modal-site-detail')">✕</button>
    </div>
    <div class="tabs">
      <div class="tab active" data-dtab="devices">장비 리스트</div>
      <div class="tab" data-dtab="access">접속 정보</div>
      <div class="tab" data-dtab="reports">점검표 파일</div>
      <div class="tab" data-dtab="notes">특이사항</div>
    </div>
    <div class="tab-pane active" id="dtab-devices">
      <div class="sec-head"><span class="sec-label">장비 목록</span><button class="btn btn-sm" onclick="openModal('modal-add-device')">+ 장비 추가</button></div>
      <div id="device-table"></div>
    </div>
    <div class="tab-pane" id="dtab-access">
      <div class="sec-head"><span class="sec-label">접속 정보</span><button class="btn btn-sm" onclick="openModal('modal-add-access')">+ 추가</button></div>
      <div id="access-table"></div>
    </div>
    <div class="tab-pane" id="dtab-reports">
      <div class="sec-head"><span class="sec-label">점검표 파일</span></div>
      <div style="margin-bottom:10px">
        <input type="file" id="file-input" style="display:none" onchange="uploadReport(event)">
        <button class="btn" onclick="document.getElementById('file-input').click()">↑ 파일 업로드</button>
      </div>
      <div id="report-table"></div>
    </div>
    <div class="tab-pane" id="dtab-notes">
      <div class="sec-head"><span class="sec-label">특이사항</span><button class="btn btn-sm" onclick="openModal('modal-add-note')">+ 추가</button></div>
      <div id="notes-list"></div>
    </div>
  </div>
</div>

<!-- 장비 추가 -->
<div class="overlay" id="modal-add-device">
  <div class="modal">
    <div class="modal-head"><div class="modal-title">장비 추가</div><button class="btn btn-sm" onclick="closeModal('modal-add-device')">✕</button></div>
    <div class="grid2">
      <div class="form-row"><label>장비명 *</label><input type="text" id="d-name"></div>
      <div class="form-row"><label>모델명</label><input type="text" id="d-model"></div>
    </div>
    <div class="grid2">
      <div class="form-row"><label>시리얼 번호</label><input type="text" id="d-sn"></div>
      <div class="form-row"><label>유형</label><select id="d-type"><option>서버</option><option>스토리지</option><option>네트워크</option><option>기타</option></select></div>
    </div>
    <div class="grid2">
      <div class="form-row"><label>OS</label><input type="text" id="d-os" placeholder="AIX 7.2, RHEL 9..."></div>
      <div class="form-row"><label>상태</label><select id="d-status"><option>운영중</option><option>점검중</option><option>교체예정</option><option>철수</option></select></div>
    </div>
    <div class="grid2">
      <div class="form-row"><label>구입일</label><input type="date" id="d-purchase"></div>
      <div class="form-row"><label>워런티 만료일</label><input type="date" id="d-warranty"></div>
    </div>
    <div class="form-row"><label>메모</label><textarea id="d-memo" style="min-height:52px"></textarea></div>
    <div class="form-actions">
      <button class="btn" onclick="closeModal('modal-add-device')">취소</button>
      <button class="btn btn-primary" onclick="saveDevice()">저장</button>
    </div>
  </div>
</div>

<!-- 장비 수정 -->
<div class="overlay" id="modal-edit-device">
  <div class="modal">
    <div class="modal-head"><div class="modal-title">장비 수정</div><button class="btn btn-sm" onclick="closeModal('modal-edit-device')">✕</button></div>
    <input type="hidden" id="ed-id">
    <div class="grid2">
      <div class="form-row"><label>장비명 *</label><input type="text" id="ed-name"></div>
      <div class="form-row"><label>모델명</label><input type="text" id="ed-model"></div>
    </div>
    <div class="grid2">
      <div class="form-row"><label>시리얼 번호</label><input type="text" id="ed-sn"></div>
      <div class="form-row"><label>유형</label><select id="ed-type"><option>서버</option><option>스토리지</option><option>네트워크</option><option>기타</option></select></div>
    </div>
    <div class="grid2">
      <div class="form-row"><label>OS</label><input type="text" id="ed-os"></div>
      <div class="form-row"><label>상태</label><select id="ed-status"><option>운영중</option><option>점검중</option><option>교체예정</option><option>철수</option></select></div>
    </div>
    <div class="grid2">
      <div class="form-row"><label>구입일</label><input type="date" id="ed-purchase"></div>
      <div class="form-row"><label>워런티 만료일</label><input type="date" id="ed-warranty"></div>
    </div>
    <div class="form-row"><label>메모</label><textarea id="ed-memo" style="min-height:52px"></textarea></div>
    <div class="form-actions">
      <button class="btn" onclick="closeModal('modal-edit-device')">취소</button>
      <button class="btn btn-primary" onclick="updateDevice()">수정</button>
    </div>
  </div>
</div>

<!-- 사이트 추가 -->
