  </div>
</div>

<!-- 이슈 추가/수정 -->
<div class="overlay" id="modal-add-issue">
  <div class="modal">
    <div class="modal-head"><div class="modal-title" id="issue-modal-title">이슈 등록</div><button class="btn btn-sm" onclick="closeModal('modal-add-issue')">✕</button></div>
    <input type="hidden" id="issue-id">
    <div class="form-row"><label>사이트 *</label><select id="issue-site"></select></div>
